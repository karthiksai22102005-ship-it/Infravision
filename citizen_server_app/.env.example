# Copy to backend/.env and fill in. NEVER commit real values. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ENVIRONMENT=development                 # development | test | production (production enforces all checks)
# SQL Server is REQUIRED. There is no silent SQLite fallback. (sqlite:/// is accepted only for ENVIRONMENT=development/test)
DATABASE_URL=mssql+pyodbc://citizen_app:<PASSWORD>@<HOST>,1433/<DATABASE>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
DB_SCHEMA=citizen
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_S=10
JWT_SECRET=<random-48+-char-secret>      # >= 32 chars, not a placeholder
# One named key per inspector: name=key;name2=key2  (each key >= 32 chars). Real Inspector auth contract: pending.
INSPECTOR_KEYS=<name>=<random-48+-char-secret>
EVIDENCE_DIR=./evidence_store
REPORT_DIR=./report_store
