# Copy to .env and replace the password locally. URL-encode special characters in it.
DATABASE_URL=mysql+pymysql://root:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:3306/infravision_citizen?charset=utf8mb4
ENVIRONMENT=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MAX_EVIDENCE_PER_COMPLAINT=7
MAX_VIDEO_EVIDENCE_BYTES=52428800
# Ollama example (no API key needed; Ollama must be reachable from this backend)
AI_PROVIDER=ollama
AI_API_KEY=
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.2:1b
# For an OpenAI-compatible hosted provider, set AI_PROVIDER=openai-compatible,
# AI_API_KEY to its secret key, AI_BASE_URL to its /v1 URL, and AI_MODEL to its model.
